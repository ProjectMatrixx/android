#

# Initialize local repository
```
repo init -u https://github.com/ProjectMatrixx/android -b 16.2 --git-lfs
```

# Sync up
```
repo sync -c -j$(nproc --all) --force-sync --no-clone-bundle --no-tags
```

# Build

- Set up the build environment
```bash
. build/envsetup.sh
```

- Lunch a target
```bash
lunch matrixx_codename-bp4a-user
```

- To start compiling
```bash
make matrixx
```

# Build Flags & Overlays

- Maintainer flag (define in matrixx_device.mk)
```make
MATRIXX_MAINTAINER := Mrick343
```

- Include MatLog Application 
```make
TARGET_INCLUDE_MATLOG := true
```

- If device support UDFPS
```make
TARGET_CUSTOM_UDFPS := true
```

- For GMS
```make
WITH_GMS := true
```
```make
WITH_EXTRA_GAPPS := true (For including extra apps in gms build i.e DocumentsUIGoogle ,Maps, PrebuiltGmail, FilesPrebuilt, Photos & Chrome-Stub)
```
```make
TARGET_INCLUDE_PIXEL_LAUNCHER := true (For Building Pixel Launcher)
```
```make
TARGET_DEFAULT_PIXEL_LAUNCHER := true (Set Pixel Launcher as default Launcher)
```
```make
WITH_GMS_COMMS_SUITE := true (For Google Telephony)
```
```make
WITH_GMS_AICORE := true (For Google AICore)
```

- For bcr
```make
WITH_BCR := true
```

- Set surfaceflinger refreshrate
```make
$(call soong_config_set,surfaceflinger,frame_rate_category_high,120)
$(call soong_config_set,surfaceflinger,frame_rate_category_min,60)
```


- Surface flinger boosting (Smoother scrolling, fewer frame drops but Keeps CPU slightly “awake”)
```make
SURFACE_FLINGER_BOOST := true
```

- Enable optimized dexopt tuning (default false, Recomended for highend devices)
```make
TARGET_OPTIMIZED_DEXOPT := true
```

- Bypass Charging
```make
BYPASS_CHARGE_SUPPORTED := true
```

- High Brightness Mode (HBM)
```make
HBM_SUPPORTED := false
HBM_NODE := /sys/class/backlight/panel0-backlight/hbm_mode
```

- Use X reality engine (careful with mtk, causes display stuck issue)
```make
USE_REALITY_ENGINE := true
```

- Drop default aperture camera
```make
PRODUCT_NO_CAMERA := true
```

- Limit AOD refreshrate (SystemUI overlay)
```make
<!-- Preferred max refresh rate at AOD & Ambient Display, if supported by the display. -->
<integer name="config_aodMaxRefreshRate">60</integer>
```
